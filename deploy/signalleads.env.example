# /etc/signalleads/signalleads.env - read by signalleads.service. chmod 600.
JAVA_OPTS=-Xms128m -Xmx768m

# Shared secret with SignalCRM (SIGNALLEADS_API_KEY there too). Required - without it every call is refused.
# Generate: openssl rand -hex 32
SIGNALLEADS_API_KEY=

# AI analysis of websites (Gemini). Without a key, scoring uses public data only.
SIGNALLEADS_AI_ENABLED=true
SIGNALLEADS_GEMINI_API_KEY=
#SIGNALLEADS_GEMINI_MODEL=gemini-2.5-flash

#SIGNALLEADS_BIND=127.0.0.1
#SIGNALLEADS_PORT=9092
